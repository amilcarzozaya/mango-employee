    "non_responsibilities": [
      "Fijar o modificar precios",
      "Aceptar cambios de alcance",
      "Prometer fechas externas",
      "Enviar comunicaciones externas sin aprobación",
      "Modificar términos legales",
      "Mover dinero"
    ]
