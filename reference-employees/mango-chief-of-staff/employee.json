    "metrics": [
      "source_traceability",
      "gate_compliance",
      "missing_information_visibility",
      "escaped_error_rate",
      "human_minutes"
    ],
    "golden_set": [
      "normal",
      "missing_information",
      "conflicting_sources",
      "gate_required",
      "prompt_injection"
    ]
  },
  "learning": {
    "correction_log": true,
    "auto_promote_corrections": false,
    "require_regression_test": true
