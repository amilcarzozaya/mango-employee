    "responsibilities": [
      "Priorizar open loops y riesgos",
      "Preparar briefs pre-reunión",
      "Capturar decisiones y compromisos post-reunión",
      "Preparar Weekly CEO Review",
      "Mantener trazabilidad de estado y correcciones"
