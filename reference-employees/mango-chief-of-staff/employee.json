  "autonomy": {
    "default_level": 0,
    "max_level": 2
  },
  "gates": [
    {
      "id": "send-gate",
      "category": "external_send",
      "requires_human_approval": true,
      "policy": "Show exact recipient and exact content; wait for explicit approval."
    },
    {
      "id": "pricing-gate",
      "category": "pricing",
      "requires_human_approval": true,
      "policy": "Never set/change price."
    },
    {
      "id": "scope-gate",
      "category": "scope",
      "requires_human_approval": true,
      "policy": "Never accept expanded scope."
    },
    {
      "id": "deadline-gate",
      "category": "deadline",
      "requires_human_approval": true,
      "policy": "Never promise a new external deadline."
    },
    {
      "id": "legal-gate",
      "category": "legal",
      "requires_human_approval": true,
      "policy": "Never modify legal terms."
    },
    {
      "id": "spend-gate",
      "category": "spend",
      "requires_human_approval": true,
      "policy": "Never spend or move money."
    }
  ],
  "routines": [
    {
      "id": "daily-command",
      "trigger": "weekday_start",
      "skill_id": "morning-command-center"
    },
    {
      "id": "weekly-review",
      "trigger": "week_close",
      "skill_id": "weekly-ceo-review"
