{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MANGO Quote Builder request v1",
  "type": "object",
  "required": [
    "client",
    "quote_date",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "client": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "company_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "email": {
          "type": [
            "string",
            "null"
          ]
        },
        "phone": {
          "type": [
            "string",
            "null"
          ]
        },
        "address": {
          "type": [
            "string",
            "null"
          ]
        },
        "tax_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "quote_date": {
      "type": "string",
      "format": "date"
    },
    "currency": {
      "type": "string"
    },
    "prices_include_tax": {
      "type": "boolean"
    },
    "validity_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 365
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": [
          "description",
          "quantity",
          "unit_price",
          "tax_codes"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "unit_price": {
            "type": "string"
          },
          "discount_percent": {
            "type": "string"
          },
          "discount_amount": {
            "type": "string"
          },
          "tax_codes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "payment_terms": {
      "type": "string"
    },
    "delivery_terms": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "revision_of": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
